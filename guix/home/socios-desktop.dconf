# SociOS desktop defaults — apply with:  dconf load / < guix/home/socios-desktop.dconf
# (or via a Guix Home home-dconf activation). Sets the reference look/feel: left
# window buttons, the standing-stones wallpaper, night-light, the Tilix quake
# drop-down keybind, and the ArcMenu tognee layout + custom theme (the ArcMenu
# keys take effect once the extension is packaged — see DESKTOP_COMPONENTS.md).

[org/gnome/desktop/wm/preferences]
button-layout='close,minimize,maximize:'

[org/gnome/desktop/background]
picture-uri='file:///run/current-system/profile/share/backgrounds/socios/standing-stones-sunset.jpg'
picture-uri-dark='file:///run/current-system/profile/share/backgrounds/socios/standing-stones-matrix.jpg'
picture-options='zoom'

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
enable-hot-corners=true

[org/gnome/settings-daemon/plugins/color]
night-light-enabled=true
night-light-temperature=uint32 3700

# Tilix quake drop-down terminal, bound to F12
[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/tilix-quake/']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/tilix-quake]
name='Tilix Quake'
command='tilix --quake'
binding='F12'

[com/gexperts/Tilix]
window-style='disable-csd-hide-toolbar'
quake-hide-lose-focus=true
quake-height-percent=uint32 50

# ArcMenu — Windows-start menu with the tognee layout + custom color theme
# (applies once gnome-shell-extension-arcmenu is in the Guix profile).
[org/gnome/shell/extensions/arcmenu]
menu-layout='Tognee'
override-menu-theme=true

[org/gnome/shell]
enabled-extensions=['arcmenu@arcmenu.com', 'places-menu@gnome-shell-extensions.gcampax.github.com', 'Vitals@CoreCoding.com', 'dash-to-dock@micxgx.gmail.com', 'appindicatorsupport@rgcjonas.gmail.com']
